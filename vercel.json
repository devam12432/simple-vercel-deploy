{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ],
  "functions": {
    "index.js": {
      "includeFiles": [
        "frontend/**",
        "backend/database/schema.sql",
        "backend/routes/**",
        "backend/services/**",
        "backend/database/database.js"
      ]
    }
  }
}
